# -----------------------------------------------------------------------------
# UC2 - Conversational Agent with IBM Verify and MCP-mediated Tool Access
# Run: uvicorn app:app --reload --host 0.0.0.0 --port 8000
# -----------------------------------------------------------------------------

APP_BASE_URL=http://localhost:8000
SESSION_SECRET=replace-with-random-secret
ALLOW_LOCAL_UNSIGNED_JWT=false

# -----------------------------------------------------------------------------
# Optional LLM
# USE_LLM=true uses Gemini for intent classification.
# USE_LLM=false uses deterministic fallback parsing.
# -----------------------------------------------------------------------------
USE_LLM=false
GEMINI_API_KEY=<your-new-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# IBM Verify tenant / authorization server endpoints
# Example issuer: https://<tenant>/oauth2
# -----------------------------------------------------------------------------
VERIFY_ISSUER=https://<tenant>/oauth2
VERIFY_AUTHORIZATION_ENDPOINT=https://<tenant>/oauth2/authorize
VERIFY_TOKEN_ENDPOINT=https://<tenant>/oauth2/token
VERIFY_JWKS_URI=https://<tenant>/oauth2/jwks
VERIFY_INTROSPECTION_ENDPOINT=https://<tenant>/oauth2/introspect

# -----------------------------------------------------------------------------
# Subject client - human user login by Authorization Code + PKCE
# Create/configure this subject client for this standalone UC2 sample.
# -----------------------------------------------------------------------------
SUBJECT_CLIENT_ID=<course-chat-ui-client-id>
SUBJECT_CLIENT_SECRET=<course-chat-ui-client-secret>
SUBJECT_REDIRECT_URI=http://localhost:8000/callback
SUBJECT_SCOPES=openid profile email

# -----------------------------------------------------------------------------
# Actor client - registered AI agent runtime identity
# Create the actor client with DCR and associate it with the UC2 agent.
# -----------------------------------------------------------------------------
# AgentID from Identities → AI agents → your agent.
AGENT_ID=<registry-agent-id-from-actor-token-sub>
ACTOR_CLIENT_ID=<course-assistant-agent-client-id>
ACTOR_CLIENT_SECRET=<course-assistant-agent-client-secret>
ACTOR_SCOPES=agent.run

# -----------------------------------------------------------------------------
# Token Exchange application
# For UC2, token is issued to the MCP server audience.
# -----------------------------------------------------------------------------
# Token Exchange application settings.
# Keep the STS_* variable names; the application reads these keys.
STS_CLIENT_ID=<token-exchange-client-id>
STS_CLIENT_SECRET=<token-exchange-client-secret>

# Basic UC2 demo: MCP validates and executes the tool locally.
STS_AUDIENCE=course-mcp-server
MCP_AUDIENCE=course-mcp-server
MCP_SERVER_NAME=course-mcp-server
DOWNSTREAM_SYSTEM=course-api
MCP_FORWARD_TO_COURSE_API=false

# Defense-in-depth option: MCP validates, then forwards the same delegated token
# to the downstream Course API validation layer. This requires the delegated token
# to include both audiences.
# STS_AUDIENCE=course-mcp-server course-api
# MCP_FORWARD_TO_COURSE_API=true
COURSE_API_AUDIENCE=course-api

# -----------------------------------------------------------------------------
# Verify Directory / SCIM lookup client
# Use a separate API/management client that can read users from Verify Directory.
# This is used only when the target is not self, e.g. "rick".
# -----------------------------------------------------------------------------
VERIFY_MANAGEMENT_CLIENT_ID=<verify-management-client-id>
VERIFY_MANAGEMENT_CLIENT_SECRET=<verify-management-client-secret>
VERIFY_MANAGEMENT_SCOPES=

# -----------------------------------------------------------------------------
# RAR / ADT
# -----------------------------------------------------------------------------
AGENT_ADT_TYPE=urn:ibm:demo:verify:mcp_tool_action
