{
  "info": {
    "name": "UC2 MCP Runtime Diagnostics",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Copyright IBM Corp. All Rights Reserved.\n\nSPDX-License-Identifier: Apache-2.0\n\nFollow docs/setup-and-api-walkthrough.md. Find the AgentID in the agent details. Configure the Token Exchange application entitlements and associate it under Agent tasks \u2192 Act on behalf of a user. Run suspension and delete requests only for the optional negative tests.\n\nStart with docs/setup.md. Use this collection as an alternative to cURL for API steps. Local STS_* environment keys contain the Token Exchange application settings; retain those key names."
  },
  "variable": [
    {
      "key": "local_app_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "tenant_url",
      "value": "https://<tenant>"
    },
    {
      "key": "resource_client_id",
      "value": ""
    },
    {
      "key": "resource_client_secret",
      "value": ""
    },
    {
      "key": "delegated_access_token",
      "value": ""
    },
    {
      "key": "logged_in_subject",
      "value": "user@example.com"
    },
    {
      "key": "subject_access_token",
      "value": ""
    },
    {
      "key": "actor_access_token",
      "value": ""
    },
    {
      "key": "sts_client_id",
      "value": ""
    },
    {
      "key": "sts_client_secret",
      "value": ""
    },
    {
      "key": "subject_resource_client_id",
      "value": ""
    },
    {
      "key": "subject_resource_client_secret",
      "value": ""
    },
    {
      "key": "course_id",
      "value": "SEC-301"
    },
    {
      "key": "tool_name",
      "value": "enroll_course"
    },
    {
      "key": "actor_client_id",
      "value": ""
    },
    {
      "key": "agent_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Application Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{local_app_url}}/health",
        "description": "Purpose: Confirm this checkout is running.\n\nBefore running: follow docs/setup-and-api-walkthrough.md; configure IDs and credentials in this collection/environment.\n\nExpected / next action: HTTP 200. If unavailable check localhost:8000 and the uvicorn terminal."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - MCP tools/list through client",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{local_app_url}}/mcp/tools",
        "description": "Purpose: Discover registered MCP tools through the client/server protocol.\n\nBefore running: follow docs/setup-and-api-walkthrough.md; configure IDs and credentials in this collection/environment.\n\nExpected / next action: HTTP 200; four tools including the intentional delete negative-test tool. Discovery grants no authority."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - MCP tools/call through client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tool_name\": \"{{tool_name}}\",\n  \"course_id\": \"{{course_id}}\",\n  \"requested_subject\": \"{{logged_in_subject}}\",\n  \"logged_in_subject\": \"{{logged_in_subject}}\",\n  \"delegated_token\": \"{{delegated_access_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{local_app_url}}/mcp/invoke",
        "description": "Purpose: Invoke the selected tool with delegated authority.\n\nBefore running: follow docs/setup-and-api-walkthrough.md; configure IDs and credentials in this collection/environment.\n\nExpected / next action: HTTP 200 for an allowed matching request; verify business result. Use the token from 05 for the same tool/course/subject."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Introspect Delegated Token as MCP Resource",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{resource_client_id}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{resource_client_secret}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "token",
              "value": "{{delegated_access_token}}",
              "type": "text"
            }
          ]
        },
        "url": "{{tenant_url}}/oauth2/introspect",
        "description": "Purpose: Inspect delegated identity and approved operation before execution.\n\nBefore running: follow docs/setup-and-api-walkthrough.md; configure IDs and credentials in this collection/environment.\n\nExpected / next action: HTTP 200; active=true; act.sub=agent_id; audience contains course-mcp-server; check scope and authorization_details."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const v = pm.response.json();",
              "  pm.test(\"Token active\", () => pm.expect(v.active).to.eql(true));",
              "  pm.test(\"Agent subject matches registry AgentID\", () => pm.expect(v.act && v.act.sub).to.eql(pm.variables.get(\"agent_id\")));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Token Exchange for Selected MCP Tool",
      "request": {
        "method": "POST",
        "url": "{{tenant_url}}/oauth2/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "urn:ietf:params:oauth:grant-type:token-exchange",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{sts_client_id}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{sts_client_secret}}",
              "type": "text"
            },
            {
              "key": "subject_token",
              "value": "{{subject_access_token}}",
              "type": "text"
            },
            {
              "key": "subject_token_type",
              "value": "urn:ietf:params:oauth:token-type:access_token",
              "type": "text"
            },
            {
              "key": "actor_token",
              "value": "{{actor_access_token}}",
              "type": "text"
            },
            {
              "key": "actor_token_type",
              "value": "urn:ietf:params:oauth:token-type:access_token",
              "type": "text"
            },
            {
              "key": "audience",
              "value": "course-mcp-server",
              "type": "text"
            },
            {
              "key": "authorization_details",
              "value": "[{\"type\": \"urn:ibm:demo:verify:agent_action\", \"courseId\": \"{{course_id}}\", \"operationDetails\": {\"creator\": \"{{actor_client_id}}\", \"affectedPerson\": \"{{logged_in_subject}}\", \"loggedInSubject\": \"{{logged_in_subject}}\", \"action\": \"{{tool_name}}\", \"targetSystem\": \"course-mcp-server\", \"resource\": \"mcp-tool\", \"toolName\": \"{{tool_name}}\", \"downstreamSystem\": \"course-api\"}}]",
              "type": "text"
            }
          ]
        },
        "description": "Purpose: Exchange a human access token and fresh actor token for the selected tool.\n\nBefore running: follow docs/setup-and-api-walkthrough.md; configure IDs and credentials in this collection/environment.\n\nExpected / next action: HTTP 200; copy access_token to delegated_access_token. Match tool_name, course_id and logged_in_subject. RAR creator remains actor_client_id.\n\nSetup: in the Token Exchange application select All users are entitled to this application for the tutorial. In the agent\u2019s Agent tasks select Act on behalf of a user, associate UC2 Course MCP Agent Token Exchange, and save. See docs/audit.md for list/enrollment audit examples."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) { const v=pm.response.json().access_token; if(v) pm.collectionVariables.set(\"delegated_access_token\", v); }"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Introspect Subject Token and may_act",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{subject_resource_client_id}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{subject_resource_client_secret}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "token",
              "value": "{{subject_access_token}}",
              "type": "text"
            }
          ]
        },
        "url": "{{tenant_url}}/oauth2/introspect",
        "description": "Purpose: Check the actual subject delegation mapping.\n\nBefore running: follow docs/setup-and-api-walkthrough.md; configure IDs and credentials in this collection/environment.\n\nExpected / next action: HTTP 200; active=true; may_act.sub=agent_id for the supplied may_act route. The human own sub stays the human identity. If using Actor Criteria instead, inspect that explicit rule and Skip default actor validation."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const v = pm.response.json();",
              "  pm.test(\"Token active\", () => pm.expect(v.active).to.eql(true));",
              "  pm.test(\"Agent subject matches registry AgentID\", () => pm.expect(v.may_act && v.may_act.sub).to.eql(pm.variables.get(\"agent_id\")));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Token Exchange for Delete - No Delete Scope",
      "request": {
        "method": "POST",
        "url": "{{tenant_url}}/oauth2/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "urn:ietf:params:oauth:grant-type:token-exchange",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{sts_client_id}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{sts_client_secret}}",
              "type": "text"
            },
            {
              "key": "subject_token",
              "value": "{{subject_access_token}}",
              "type": "text"
            },
            {
              "key": "subject_token_type",
              "value": "urn:ietf:params:oauth:token-type:access_token",
              "type": "text"
            },
            {
              "key": "actor_token",
              "value": "{{actor_access_token}}",
              "type": "text"
            },
            {
              "key": "actor_token_type",
              "value": "urn:ietf:params:oauth:token-type:access_token",
              "type": "text"
            },
            {
              "key": "audience",
              "value": "course-mcp-server",
              "type": "text"
            },
            {
              "key": "authorization_details",
              "value": "[{\"type\": \"urn:ibm:demo:verify:agent_action\", \"courseId\": \"ALL\", \"operationDetails\": {\"creator\": \"{{actor_client_id}}\", \"affectedPerson\": \"{{logged_in_subject}}\", \"loggedInSubject\": \"{{logged_in_subject}}\", \"action\": \"delete_course_history\", \"targetSystem\": \"course-mcp-server\", \"resource\": \"mcp-tool\", \"toolName\": \"delete_course_history\", \"downstreamSystem\": \"course-api\"}}]",
              "type": "text"
            }
          ]
        },
        "description": "Purpose: Optional negative test: obtain a delete-intent token without the delete scope.\n\nBefore running: follow docs/setup-and-api-walkthrough.md; configure IDs and credentials in this collection/environment.\n\nExpected / next action: HTTP 200 only if policy permits issuance; expected scope excludes course.delete. Copy returned access_token, then run 08. A policy denial at Token Exchange is a different observed stage.\n\nSetup: in the Token Exchange application select All users are entitled to this application for the tutorial. In the agent\u2019s Agent tasks select Act on behalf of a user, associate UC2 Course MCP Agent Token Exchange, and save. See docs/audit.md for list/enrollment audit examples."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) { const v=pm.response.json().access_token; if(v) pm.collectionVariables.set(\"delegated_access_token\", v); }"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Invoke Delete - Expect Scope Denial",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tool_name\": \"delete_course_history\",\n  \"course_id\": \"ALL\",\n  \"requested_subject\": \"{{logged_in_subject}}\",\n  \"logged_in_subject\": \"{{logged_in_subject}}\",\n  \"delegated_token\": \"{{delegated_access_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{local_app_url}}/mcp/invoke",
        "description": "Purpose: Prove the resource boundary rejects missing business authority.\n\nBefore running: follow docs/setup-and-api-walkthrough.md; configure IDs and credentials in this collection/environment.\n\nExpected / next action: HTTP 403 with denied_stage=scope and reason mentioning course.delete. No data should be deleted with the supplied mapping."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Delete denied by required scope\", function () { pm.response.to.have.status(403); const result = pm.response.json(); pm.expect(result.denied_stage).to.eql(\"scope\"); pm.expect(result.reason).to.include(\"course.delete\"); });"
            ]
          }
        }
      ]
    }
  ]
}
